# Copy to .env and fill in what you need. Every value is optional.

# --- AI ----------------------------------------------------------------------
# Google Gemini. The free tier needs no card: https://aistudio.google.com/apikey
# Without a key the app runs in offline mode (heuristics + templates).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used in order when the primary model is rate limited or overloaded.
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite
# Seconds (in ms) to understand a message, and to word the reply, before using the fallback.
AI_TIMEOUT_MS=8000
AI_REPLY_BUDGET_MS=2500

# --- Security ----------------------------------------------------------------
# Password for the support console. Change it for anything beyond local review.
ADMIN_PASSWORD=worknoon-admin
# Signs session tokens. Use a long random value outside local development:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret

# --- Demo --------------------------------------------------------------------
# Enables the demo customer switcher and the "reset demo data" button.
DEMO_MODE=true
# Fill the console with a week of sample activity on first boot.
SEED_SAMPLE_ACTIVITY=true
LOG_LEVEL=info
