# Copy to .env and fill in what you need. Every value is optional.

# --- AI provider -------------------------------------------------------------
# auto (default) uses Anthropic if its key is set, else OpenAI, else Gemini, else offline mode.
# Gemini has a free tier (no card): create a key at https://aistudio.google.com/apikey
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=30000

# --- Security ----------------------------------------------------------------
# Password for the support console. Change it for anything beyond local review.
ADMIN_PASSWORD=worknoon-admin
# Signs session tokens. Use a long random value outside local development:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret

# --- Demo --------------------------------------------------------------------
# Enables the demo customer switcher and the "reset demo data" button.
DEMO_MODE=true
LOG_LEVEL=info
